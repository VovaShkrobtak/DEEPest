extends SceneTree
const Kernel = preload("res://src/core/kernel.gd")
const Parser = preload("res://src/application/parser.gd")
var failures: Array[String] = []
func check(ok: bool, label: String) -> void:
	if not ok: failures.append(label)
func do_action(k: RefCounted, id: String) -> bool:
	if not k.command(id).ok: return false
	return k.step(86400).ok and k.export_state().action.is_empty()
func _initialize() -> void:
	var k = Kernel.new(1998)
	var initial: Dictionary = k.export_state()
	var p = Parser.new().parse("разобрать табуретку",k.available_actions())
	check(p.ok and p.id=="prop_dismantle:shelter_stool","Language resolves object")
	check(do_action(k,"prop_inspect:shelter_wardrobe"),"Can inspect property-driven object")
	check(do_action(k,"prop_dismantle:shelter_stool"),"Can dismantle furniture")
	check(int(k.export_state().ground.shelter.wood)==2,"Salvage remains on ground")
	check(not k.command("prop_dismantle:shelter_stool").ok,"No duplicated salvage")
	var previous_wood: int = int(k.export_state().items.inventory.wood)
	check(do_action(k,"ground_take:wood"),"Can pick up one resource")
	check(int(k.export_state().items.inventory.wood)==previous_wood+1,"Mass transferred to inventory")
	var saved: Dictionary = JSON.parse_string(JSON.stringify(k.export_state()))
	var restored = Kernel.new(1)
	check(restored.restore_state(saved).ok,"Save roundtrip of furniture and ground")
	check(restored.export_state().props==saved.props,"Identity and position retained")
	check(do_action(k,"door_close:yard"),"Can close door")
	check(do_action(k,"prop_brace:shelter_wardrobe:yard"),"Can block door with wardrobe")
	check(float(k.export_state().zombies.doors["shelter|yard"].brace_kg)>2.0,"Furniture affects real door physics")
	check(not k.command("door_open:yard").ok,"Blocked door stays shut")
	check(do_action(k,"prop_unbrace:shelter_wardrobe"),"Furniture removable")
	check(is_zero_approx(float(k.export_state().zombies.doors["shelter|yard"].brace_kg)),"Door mechanics restored")
	check(int(k.export_state().items.inventory.wood)==previous_wood+1,"No conjured wood after object release")
	check(do_action(k,"door_open:yard"),"Door can open again")
	check(do_action(k,"prop_move:shelter_wardrobe:yard"),"Can move object between connected places")
	check(str(k.export_state().props.entities.shelter_wardrobe.location)=="yard","Moved prop persists")
	check(not k.command("prop_dismantle:shelter_wardrobe").ok,"Cannot reach remote prop")
	var broken: Dictionary = k.export_state()
	broken.props.entities.shelter_wardrobe.location = "nowhere"
	var safe: Dictionary = k.export_state()
	check(not k.restore_state(broken).ok and k.export_state()==safe,"Forged location rejected atomically")
	var legacy: Dictionary = initial.duplicate(true)
	legacy.erase("props")
	var migrated = Kernel.new(8)
	check(migrated.restore_state(legacy).ok and migrated.export_state().props.entities.has("shelter_stool"),"Previous saves migrate")
	print("Object integration: ","PASS" if failures.is_empty() else JSON.stringify(failures))
	quit(0 if failures.is_empty() else 1)
