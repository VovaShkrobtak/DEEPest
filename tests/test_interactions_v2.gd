extends SceneTree
const Kernel = preload("res://src/core/kernel.gd")
const Items = preload("res://src/domain/items.gd")
var errors: Array[String] = []
func check(ok: bool,label: String) -> void:
	if not ok: errors.append(label)
func perform(k: RefCounted,id: String,params: Dictionary = {}) -> bool:
	if not k.command(id,params).ok: return false
	return k.step(86400).ok and k.export_state().action.is_empty()
func _initialize() -> void:
	var k = Kernel.new(1998)
	var starting: Dictionary = k.export_state()
	var material: Dictionary = {"a":"wood","b":"cloth","link":"wire"}
	check(not k.command("assembly_build",{"a":"wood","b":"wood","link":"parts"}).ok,"Insufficient duplicate materials must fail")
	check(perform(k,"assembly_build",material),"Composition consumes real materials")
	var state: Dictionary = k.export_state()
	check(state.assemblies.entities.size()==1 and state.assemblies.entities.has("assembly_0001"),"Stable assembly identity")
	check(int(state.items.inventory.wood)==int(starting.items.inventory.wood)-1,"Wood conserved")
	check(int(state.items.inventory.cloth)==int(starting.items.inventory.cloth)-1,"Cloth conserved")
	check(int(state.items.inventory.wire)==int(starting.items.inventory.wire)-1,"Fastener conserved")
	check(perform(k,"door_close:yard"),"Can close doorway")
	check(perform(k,"assembly_brace:assembly_0001:yard"),"Assembly physically braces door")
	var braced: float = float(k.export_state().zombies.doors["shelter|yard"].brace_kg)
	check(braced>0.0 and not k.command("door_open:yard").ok,"Door blocks passage")
	var saved: Dictionary = JSON.parse_string(JSON.stringify(k.export_state()))
	var loaded = Kernel.new(2)
	check(loaded.restore_state(saved).ok,"Save roundtrip with assembled and braced object")
	check(loaded.export_state().assemblies==saved.assemblies,"Save retains structures")
	check(perform(k,"assembly_unbrace:assembly_0001"),"Can unbrace without duplicating materials")
	check(is_zero_approx(float(k.export_state().zombies.doors["shelter|yard"].brace_kg)),"Mechanical brace weight removed")
	check(perform(k,"assembly_disassemble:assembly_0001"),"Can disassemble using same parts")
	check(k.export_state().assemblies.entities.is_empty(),"No stale construction")
	check(int(k.export_state().ground.shelter.wood)==1 and int(k.export_state().ground.shelter.cloth)==1 and int(k.export_state().ground.shelter.wire)==1,"Recovery outputs exactly consumed components")
	check(not k.command("assembly_disassemble:assembly_0001").ok,"Cannot duplicate reused parts")
	check(perform(k,"ground_drop:matches",{"amount":3}),"Drop arbitrary inventory stack")
	check(int(k.export_state().ground.shelter.matches)==3,"Matches persist at shelter")
	check(int(k.export_state().items.inventory.matches)==int(starting.items.inventory.matches)-3,"Inventory debited")
	check(perform(k,"ground_take:matches",{"amount":2}),"Pick up batch")
	check(int(k.export_state().ground.shelter.matches)==1,"Ground decremented once")
	check(int(k.export_state().items.inventory.matches)==int(starting.items.inventory.matches)-1,"Only two moved back")
	check(not k.command("ground_take:matches",{"amount":999}).ok,"Cannot take absent stack")
	var stable: Dictionary = k.export_state()
	check(not k.command("ground_drop:matches",{"amount":-1}).ok and k.export_state()==stable,"Invalid negative stack rejected without mutation")
	check(perform(k,"door_open:yard"),"Opening route")
	check(perform(k,"move:yard"),"Arriving at yard")
	check(perform(k,"ground_drop:ration",{"amount":2}),"Drop food outdoors")
	check(int(k.export_state().ground.yard.ration)==2 and int(k.export_state().ground.shelter.matches)==1,"Ground is location-local")
	check(perform(k,"move:shelter"),"Return indoors")
	check(not k.export_state().ground.get("shelter",{}).has("ration"),"Outdoor stock does not teleport")
	var corrupted: Dictionary = k.export_state()
	corrupted.assemblies.next_id = -5
	check(not k.restore_state(corrupted).ok,"Corrupt assemblies rejected")
	var legacy: Dictionary = starting.duplicate(true)
	legacy.erase("assemblies")
	var old = Kernel.new(3)
	check(old.restore_state(legacy).ok,"Older saves migrate")
	print("Interactions 2.0 tests: ","PASS" if errors.is_empty() else JSON.stringify(errors))
	quit(0 if errors.is_empty() else 1)
