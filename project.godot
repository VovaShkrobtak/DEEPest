; DEEPest — first playable, engine pinned to Godot 4.6.3
config_version=5

[application]
config/name="DEEPest"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=360
window/size/min_height=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.043,0.055,0.063,1)

[input_devices]
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true
